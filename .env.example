# Set these in Railway Variables; public Supabase values are safe only with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep this server-only. Never expose it as NEXT_PUBLIC_... .
SUPABASE_SERVICE_ROLE_KEY=
# Optional real CS2 server registry. Empty = explicitly labeled demo catalogue.
CS2_SERVERS_JSON=
# Secret of at least 32 random characters for your trusted telemetry bridge.
CS2_INGEST_TOKEN=
